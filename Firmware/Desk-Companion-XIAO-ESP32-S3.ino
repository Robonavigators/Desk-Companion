.scanhead{display:flex;align-items:center;justify-content:space-between;gap:12px}.scanhead label{margin:0}.scanbtn{padding:9px 13px!important;white-space:nowrap}.scanresults{display:none;margin:12px 0 2px;max-height:245px;overflow:auto;border:1px solid var(--line);background:#fbfcfb;border-radius:12px}.scanresults.visible{display:block}.scanitem{width:100%;border:0;border-bottom:1px solid var(--line);background:transparent;display:flex;align-items:center;justify-content:space-between;gap:14px;text-align:left;padding:12px 14px;color:var(--text);font-size:13px}.scanitem:last-child{border-bottom:0}.scanitem:hover,.scanitem:focus-visible{background:var(--accentLight);outline:0}.scanmeta{font-size:11px;color:var(--sub);white-space:nowrap}.scanhint{padding:13px;color:var(--sub);font-size:12px}

/* Native-feeling, accessible in-app dialogs and notifications. */
.dialog-backdrop{position:fixed;inset:0;z-index:1000;display:flex;justify-content:center;align-items:center;padding:18px;background:rgba(20,37,31,.42);backdrop-filter:blur(7px);opacity:0;visibility:hidden;transition:opacity .18s ease,visibility .18s ease}
.dialog-backdrop.open{opacity:1;visibility:visible}.dialog-panel{width:min(100%,430px);background:#fff;border:1px solid #e7ebe7;border-radius:20px;padding:27px;box-shadow:0 25px 90px rgba(23,38,30,.20);transform:translateY(12px) scale(.98);transition:transform .2s ease}.dialog-backdrop.open .dialog-panel{transform:translateY(0) scale(1)}
.dialog-icon{display:grid;place-items:center;width:46px;height:46px;border-radius:14px;color:#2a6b54;background:#eaf3ed;margin-bottom:18px}.dialog-icon.danger{color:#a55234;background:#fcf0e9}
.dialog-panel h2{font-size:21px;letter-spacing:-.6px;margin:0 0 9px;color:#182c23}.dialog-panel p{font-size:13px;line-height:1.7;color:#69796f;margin:0 0 24px}.dialog-actions{display:flex;justify-content:flex-end;gap:10px;flex-wrap:wrap}.dialog-actions .btn{min-width:96px;justify-content:center}.btn.destructive{background:#a64e38;border-color:#a64e38;color:white}.btn.destructive:hover{background:#8b3d2a}
.toast-stack{position:fixed;top:20px;right:20px;z-index:1100;display:flex;flex-direction:column;gap:10px;width:min(375px,calc(100vw - 36px));pointer-events:none}.app-toast{display:flex;align-items:start;gap:12px;padding:14px 15px;background:#fff;border:1px solid #e0e8e1;border-radius:15px;box-shadow:0 10px 45px rgba(24,47,36,.13);pointer-events:auto;animation:toast-in .22s ease}.app-toast.error{border-color:#f0d3d0}.app-toast .toast-symbol{flex:none;color:#297252;margin-top:2px}.app-toast.error .toast-symbol{color:#bb4a42}.app-toast .toast-body{flex:1;min-width:0}.app-toast strong{display:block;font-size:13px;color:#22372c;margin:0 0 3px}.app-toast p{margin:0;font-size:12px;line-height:1.55;color:#6a7a70;overflow-wrap:anywhere}.app-toast button{padding:2px;border:0;background:none;color:#87948b;cursor:pointer}.app-toast svg{width:18px;height:18px;display:block}
@keyframes toast-in{from{opacity:0;transform:translateY(-8px)}to{opacity:1;transform:translateY(0)}}@media(max-width:600px){.toast-stack{top:auto;bottom:18px;right:18px}.dialog-panel{padding:23px}}
@media(prefers-reduced-motion:reduce){.dialog-backdrop,.dialog-panel,.app-toast{transition:none;animation:none}}

/* Searchable, fully custom emotion selector (no native browser dropdown). */
.emotion-search-trigger{-webkit-user-select:none;user-select:none;-webkit-tap-highlight-color:transparent;touch-action:manipulation;display:grid;place-items:center;border:0;background:transparent;color:#74847a;padding:7px;cursor:pointer;border-radius:6px;flex:none}.emotion-search-trigger:hover,.emotion-search-trigger:focus-visible{background:#eef4ef;color:#176953}.emotion-search-box input[readonly]{cursor:pointer;caret-color:transparent}.emotion-search-box input:not([readonly]){caret-color:auto}
.emotion-picker{position:relative}.emotion-search-box{display:flex;align-items:center;gap:9px;background:#fff;border:1px solid #dfe5df;border-radius:10px;padding:0 10px;color:#74847a;transition:box-shadow .15s,border-color .15s}.emotion-search-box:focus-within{border-color:#5d9c7f;box-shadow:0 0 0 3px #e7f5eb}.emotion-search-box input{padding:12px 0;flex:1;min-width:0;border:0;box-shadow:none!important;background:transparent}.emotion-clear{display:grid;place-items:center;border:0;background:transparent;color:#829087;padding:5px;border-radius:6px}.emotion-clear:hover{color:#245f48;background:#eef4ef}.emotion-options{display:none;position:absolute;left:0;right:0;top:calc(100% - 23px);z-index:25;border:1px solid #dce7de;border-radius:13px;padding:6px;background:#fff;box-shadow:0 16px 44px rgba(21,36,29,.14);max-height:244px;overflow:auto}.emotion-picker.open .emotion-options{display:block}.emotion-option{width:100%;display:flex;align-items:center;justify-content:space-between;text-align:left;padding:10px 12px;background:transparent;border:0;border-radius:8px;color:#34483a;font-size:13px}.emotion-option:hover{box-shadow:inset 0 0 0 1px #dce7de}.emotion-option.focused{outline:1px solid #a8bcb1;outline-offset:-2px}.emotion-option.selected{font-weight:750;background:#edf6f1;color:#176953}.emotion-option svg{color:#176953}.emotion-empty{padding:18px 12px;color:#87948a;font-size:12px;text-align:center}.emotion-current{color:#78887d;font-size:11px;padding-top:8px}

.password-wrap{position:relative;width:100%}.password-wrap input{width:100%;padding-right:48px;box-sizing:border-box}.password-toggle{position:absolute;right:6px;top:50%;transform:translateY(-50%);width:36px;height:32px;display:grid;place-items:center;background:transparent;color:var(--sub);border:0;border-radius:6px;cursor:pointer}.password-toggle:focus-visible{outline:2px solid var(--accent)}.emotion-option .face-preview{width:76px;height:38px;flex:0 0 76px;border-radius:5px;background:#080d14;image-rendering:pixelated}.emotion-option span{flex:1;text-align:left}

/* Spacious emotion picker */
.emotion-options{padding:8px;max-height:min(360px,45vh);overscroll-behavior:contain}.emotion-option{display:grid;grid-template-columns:76px minmax(0,1fr) auto;gap:16px;align-items:center;justify-content:start;padding:12px 10px;min-height:64px;border-radius:8px;font-size:14px}.emotion-option+.emotion-option{border-top:1px solid #eef1ee}.emotion-option .face-preview{display:block;width:76px;height:38px;flex:none;image-rendering:auto}.emotion-option span{min-width:0;overflow-wrap:anywhere;line-height:1.4}.emotion-option>svg{width:16px;height:16px;flex:none}.emotion-option.auto-option{grid-template-columns:minmax(0,1fr) auto;min-height:48px}.emotion-option.auto-option span{overflow-wrap:normal}
