<script>
const faceBits=["","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","","",""];
function facePreview(id){const c=document.createElement("canvas");c.width=128;c.height=64;c.className="face-preview";c.setAttribute("aria-hidden","true");const g=c.getContext("2d"),b=atob(faceBits[id]),p=g.createImageData(128,64);for(let i=0;i<8192;i++){const on=(b.charCodeAt(i>>3)>>(i&7))&1;const j=i*4;p.data[j]=on?255:8;p.data[j+1]=on?255:13;p.data[j+2]=on?255:20;p.data[j+3]=255;}g.putImageData(p,0,0);return c;}
const eyeIcon='<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/>'; 
for(const field of document.querySelectorAll('input[type="password"]')){const wrap=document.createElement('div');wrap.className='password-wrap';field.before(wrap);wrap.append(field);const b=document.createElement('button');b.type='button';b.className='password-toggle';b.setAttribute('aria-controls',field.id);const refresh=()=>{const shown=field.type==='text';b.innerHTML=eyeIcon+(shown?'<path d="M3 3l18 18"/>':'')+'</svg>';b.setAttribute('aria-label',shown?'Hide password':'Show password');b.title=shown?'Hide password':'Show password';b.setAttribute('aria-pressed',String(shown));};b.onclick=()=>{field.type=field.type==='password'?'text':'password';refresh()};wrap.append(b);refresh();field.form?.addEventListener('submit',()=>{field.type='password';refresh()});}

const $=id=>document.getElementById(id);let filled=false;let state={};const emotions='Neutral,Happy,Sad,Angry,Surprised,Sleepy,Love,Wink,Confused,Scared,Bored,Excited,Crying,Laughing,Suspicious,Dizzy,Sick,Cool,Shocked,Annoyed,Curious,Thinking,Embarrassed,Proud,Worried,Blink,Jealous,Grumpy,Mischievous,Shy,Nervous,Ecstatic,Frustrated,Hopeful,Grateful,Nostalgic,Determined,Playful,Sarcastic,Smug,Guilty,Relieved,Anxious,Content,Irritated,Amused,Skeptical,Horrified,Peaceful,Starstruck,Drowsy,Puzzled,Devious,Humble,Optimistic,Pessimistic,Focused,Daydreaming,Miserable,Cheeky,Alert,Calm,Furious,Tearful,Hysterical,Smitten'.split(',');let chosenEmotion=-1,emotionFocus=-1;
const emotionChoices=[{name:'Automatic — all 66 emotions',id:-1},...emotions.map((name,id)=>({name,id}))];
const checkSvg='<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m5 12 4 4L19 6"/></svg>';
let emotionSearchActive=false;
function closeEmotionPicker(){const input=$('emotionSearch');$('emotionPicker').classList.remove('open');input.setAttribute('aria-expanded','false');input.readOnly=true;input.blur();emotionSearchActive=false;emotionFocus=-1;}
function finishEmotionSearch(){emotionSearchActive=false;const input=$('emotionSearch');input.blur();input.value='';}
function beginEmotionSearch(){
  const input=$('emotionSearch');
  if(!$('emotionPicker').classList.contains('open')){
    input.readOnly=true;
    openEmotionPicker();
    return;
  }
  input.readOnly=false;
  emotionSearchActive=true;
  input.focus({preventScroll:true});
}
function renderEmotions(){
  const box=$('emotionOptions');box.replaceChildren();const query=$('emotionSearch').value.trim().toLowerCase();
  const results=emotionChoices.filter(x=>x.name.toLowerCase().includes(query));
  emotionFocus=results.length?Math.min(Math.max(emotionFocus,0),results.length-1):-1;
  if(!results.length){const empty=document.createElement('div');empty.className='emotion-empty';empty.textContent='No matching emotions';box.append(empty);return;}
  results.forEach((item,index)=>{
    const button=document.createElement('button');button.type='button';button.setAttribute('role','option');button.setAttribute('aria-selected',String(item.id===chosenEmotion));button.className='emotion-option'+(item.id<0?' auto-option':'')+(item.id===chosenEmotion?' selected':'')+(index===emotionFocus?' focused':'');
    const name=document.createElement('span');name.textContent=item.name;if(item.id>=0)button.append(facePreview(item.id));button.append(name);
    if(item.id===chosenEmotion)button.insertAdjacentHTML('beforeend',checkSvg);
    button.addEventListener('mousedown',e=>e.preventDefault());button.addEventListener('click',e=>{e.stopPropagation();chooseEmotion(item.id);});box.append(button);
  });
}
function openEmotionPicker(){ if(!$('emotionPicker').classList.contains('open')){const q=$('emotionSearch').value.trim().toLowerCase();emotionFocus=emotionChoices.filter(x=>x.name.toLowerCase().includes(q)).findIndex(x=>x.id===chosenEmotion);} $('emotionPicker').classList.add('open');$('emotionSearch').setAttribute('aria-expanded','true');renderEmotions(); }
function syncEmotionInterval(){
  $('emotionIntervalPanel').hidden=chosenEmotion>=0;
  const input=$('emotionInterval');if(!intervalDirty && document.activeElement!==input)input.value=state.emotionInterval||5;
}
let intervalDirty=false;
$('emotionInterval').addEventListener('input',()=>{intervalDirty=true});
$('saveEmotionInterval').onclick=async()=>{const input=$('emotionInterval');if(!input.reportValidity())return;const n=Number(input.value);try{await request('/api/emotion/interval',{seconds:n});intervalDirty=false;await status()}catch(e){msg(e.message,true)}};
function chooseEmotion(id){
  finishEmotionSearch();chosenEmotion=id; $('emotionCurrent').textContent='Mode: '+(id<0?'Automatic — all 66 emotions':emotions[id]);
  syncEmotionInterval();const box=$('emotionOptions');const scroll=box.scrollTop;const results=emotionChoices.filter(x=>x.name.toLowerCase().includes($('emotionSearch').value.trim().toLowerCase()));emotionFocus=results.findIndex(x=>x.id===id);renderEmotions();box.scrollTop=scroll;call('/api/emotion',{emotion:id});
}
// First tap opens the emotion list without keyboard. Second tap on Search enables typing.
$('emotionSearchButton').addEventListener('click',e=>{e.preventDefault();e.stopPropagation();beginEmotionSearch();});
$('emotionSearch').addEventListener('pointerdown',e=>{
  if(!$('emotionPicker').classList.contains('open')){
    e.preventDefault(); // suppress Android's keyboard on the opening tap
    openEmotionPicker();
  } else {
    $('emotionSearch').readOnly=false;
    emotionSearchActive=true;
  }
});
$('emotionSearch').addEventListener('click',e=>{
  e.stopPropagation();
  if(!$('emotionPicker').classList.contains('open'))openEmotionPicker();
  else if(emotionSearchActive){$('emotionSearch').readOnly=false;$('emotionSearch').focus({preventScroll:true});}
});
$('emotionSearch').addEventListener('input',()=>{emotionFocus=0;openEmotionPicker()});
$('emotionSearch').addEventListener('keydown',e=>{
  if(e.key==='Escape'){e.preventDefault();closeEmotionPicker();$('emotionSearch').blur();return;}
  if(e.key==='ArrowDown'||e.key==='ArrowUp'){
    e.preventDefault();if(!$('emotionPicker').classList.contains('open'))openEmotionPicker();
    const count=$('emotionOptions').querySelectorAll('.emotion-option').length;
    if(count){emotionFocus=(emotionFocus+(e.key==='ArrowDown'?1:-1)+count)%count;renderEmotions();$('emotionOptions').querySelectorAll('.emotion-option')[emotionFocus]?.scrollIntoView({block:'nearest'});}return;
  }
  if(e.key==='Enter'&&$('emotionPicker').classList.contains('open')){e.preventDefault();$('emotionOptions').querySelectorAll('.emotion-option')[Math.max(emotionFocus,0)]?.click();}
});
document.addEventListener('click',e=>{if(!$('emotionPicker').contains(e.target))closeEmotionPicker()});;
const ICON_CHECK='<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>';
const ICON_ERROR='<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v6M12 17h.01"/></svg>';
const ICON_CLOSE='<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M18 6 6 18M6 6l12 12"/></svg>';
function msg(t,bad=false){
  // Also maintain the inline status for screen readers and as a non-popup fallback.
  $('message').textContent=t;$('message').style.color=bad?'#be123c':'#047857';
  const stack=$('toastStack'), toast=document.createElement('div');
  toast.className='app-toast'+(bad?' error':'');
  const symbol=document.createElement('span');symbol.className='toast-symbol';symbol.innerHTML=bad?ICON_ERROR:ICON_CHECK;
  const content=document.createElement('div');content.className='toast-body';
  const title=document.createElement('strong');title.textContent=bad?'Something went wrong':'Desk-Companion';
  const detail=document.createElement('p');detail.textContent=t;content.append(title,detail);
  const close=document.createElement('button');close.type='button';close.setAttribute('aria-label','Dismiss notification');close.innerHTML=ICON_CLOSE;close.onclick=()=>toast.remove();
  toast.append(symbol,content,close);stack.prepend(toast);
  while(stack.childElementCount>3)stack.lastElementChild.remove();
  setTimeout(()=>toast.remove(),bad?6500:4000);
}
let dialogResolver=null,dialogLastFocus=null;
function closeDialog(accepted){
  const overlay=$('customDialog');overlay.classList.remove('open');overlay.setAttribute('aria-hidden','true');
  document.body.style.overflow='';
  if(dialogLastFocus && dialogLastFocus.isConnected)dialogLastFocus.focus();
  const finish=dialogResolver;dialogResolver=null;if(finish)finish(accepted);
}
function confirmAction(title,description,actionLabel='Continue',danger=false){
  if(dialogResolver)closeDialog(false);
  return new Promise(resolve=>{
    dialogResolver=resolve;dialogLastFocus=document.activeElement;
    $('dialogTitle').textContent=title;$('dialogDescription').textContent=description;
    $('dialogAccept').textContent=actionLabel;
    $('dialogAccept').className='btn '+(danger?'destructive':'primary');
    $('dialogIcon').classList.toggle('danger',danger);
    const overlay=$('customDialog');overlay.classList.add('open');overlay.setAttribute('aria-hidden','false');
    document.body.style.overflow='hidden';$('dialogCancel').focus();
  });
}
$('dialogCancel').onclick=()=>closeDialog(false);
$('dialogAccept').onclick=()=>closeDialog(true);
$('customDialog').addEventListener('click',e=>{if(e.target===$('customDialog'))closeDialog(false)});
document.addEventListener('keydown',e=>{
  const open=$('customDialog').classList.contains('open');if(!open)return;
  if(e.key==='Escape'){e.preventDefault();closeDialog(false)}
  if(e.key==='Tab'){
    const first=$('dialogCancel'),last=$('dialogAccept');
    if(e.shiftKey&&document.activeElement===first){e.preventDefault();last.focus()}
    else if(!e.shiftKey&&document.activeElement===last){e.preventDefault();first.focus()}
  }
});
async function request(path,data){const r=await fetch(path,{method:'POST',headers:{'Content-Type':'application/x-www-form-urlencoded'},body:new URLSearchParams(data)});const o=await r.json();if(!r.ok)throw Error(o.error||'Request failed');msg(o.message||'Saved!');return o}
let statusBusy=false;async function status(){if(statusBusy)return;statusBusy=true;const started=performance.now();const controller=new AbortController();const timeout=setTimeout(()=>controller.abort(),3000);try{const r=await fetch('/api/status',{cache:'no-store',signal:controller.signal});if(!r.ok)throw Error('Not connected');state=await r.json();const up=$('installFirmware');up.hidden=!state.updateAvailable;$('firmwareUpdateText').textContent=state.updateAvailable?'Stable '+state.latestVersion+' available — install when convenient.':(state.firmwareVersion==='v0.0.0'?'Development build — stable update checks enabled.':'Current version '+state.firmwareVersion+' · No newer stable release.');$('conn').textContent='Demo mode';$('connectionBadge').classList.remove('offline');$('wifilabel').textContent=state.wifiConnected?state.ssid:'Offline / AP';$('temperature').textContent=Number.isFinite(state.cpuTempC)?state.cpuTempC.toFixed(1)+'°C':'Unavailable';$('timeZoneStatus').textContent=state.weatherReady?'UTC '+(state.offset>=0?'+':'')+(state.offset/60).toFixed(2)+' h':'Awaiting weather sync';$('uptime').textContent=Math.floor(state.uptime/3600)+'h '+(Math.floor(state.uptime/60)%60)+'m';$('ap').textContent=state.ap;$('ip').textContent=state.ip;$('emo').textContent=emotions[state.emotion]||'—';document.querySelectorAll('#screens button').forEach(b=>b.classList.toggle('active',+b.dataset.screen===state.screen));chosenEmotion=state.manualEmotion?state.emotion:-1;$('emotionCurrent').textContent='Mode: '+(chosenEmotion<0?'Automatic — all 66 emotions':emotions[chosenEmotion]||'Unknown');syncEmotionInterval();if($('emotionPicker').classList.contains('open'))renderEmotions();if(!filled){$('ssid').value=state.savedSSID||'';$('ssid2').value=state.savedSSID2||'';$('city').value=state.city||'';$('state').value=state.state||'';$('country').value=state.country||'';filled=true}}catch(e){$('conn').textContent='Offline';$('connectionBadge').classList.add('offline')}finally{clearTimeout(timeout);statusBusy=false}}
async function installFirmwareUpdate(){if(!await confirmAction('Install stable firmware update?','Desk-Companion will download the official release, restart, and briefly disconnect. Keep power connected.','Install update'))return;const b=$('installFirmware');b.disabled=true;try{const r=await fetch('/api/update/install',{method:'POST'});const d=await r.json();if(!r.ok)throw Error(d.error||'Could not start update');$('firmwareUpdateText').textContent='Installing update… Keep device powered.';b.hidden=true}catch(e){msg(e.message,true);b.disabled=false}}
